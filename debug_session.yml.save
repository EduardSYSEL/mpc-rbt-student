name: "communication_example"
root: <%= @settings["working_directory"] %>

# Spustí se hned po otevření projektu
on_project_start:
  - ./build.sh

# Před otevřením oken nastav ROS prostředí
pre_window:
  - source /opt/ros/humble/setup.bash

# Hlavní okno s rozdělenými panely
startup_window: debugging
windows:
  - debugging:
      layout: even-vertical
      panes:
        - ./run_receiver.sh
        - ./run_sender.shname: "communication_example"
root: <%= @settings["working_directory"]%>

on_project_start: echo "Build the programs here !"
pre_window:
  - source /opt/ros/humble/setup.bash

startup_window: debugging
windows:
  - debugging:
      layout: even-vertical
      panes:
        - echo "Run the receiver here !"
        - echo "Run the sender here !"
